# `engine-strict=true` is deliberately NOT set.
#
# It applies to every transitive dependency, not just this package, so a dev
# tool whose own floor drifts upward (ESLint's, in practice) turns a lint-only
# concern into a hard install failure on a Node version the connector itself
# supports perfectly well. That is a bad trade: it blocks people from running
# the thing over a tool they need only in order to lint it.
#
# The runtime floor that actually matters is enforced where it belongs — as a
# check in src/main.ts, which fails with a message that says what to do.
save-exact=false
